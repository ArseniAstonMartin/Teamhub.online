# ─────────────────────────────────────────────────────────────
# Teamhub Backend — Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# See PRD §26.2 for the full provisioning checklist.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/teamhub
DB_USER=postgres
DB_PASSWORD=changeme

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Actuator metrics scrape auth (Prometheus) ──────────────
# Used by Prometheus to scrape /actuator/prometheus in Coolify.
ACTUATOR_USERNAME=actuator
ACTUATOR_PASSWORD=change-this-in-coolify

# ── Persistent application log file (optional local, required in prod) ──
# In Coolify production, set this to:
# /var/log/teamhub/backend/application.log
# and mount a persistent volume at /var/log/teamhub/backend.
LOGGING_FILE_NAME=

# ── JWT RS256 key pair (PEM file paths) ────────────────────
# Leave blank to generate an ephemeral key pair at startup
# (development only — always set persistent paths in prod, PRD §24.4).
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# ── Google OAuth 2.0 ───────────────────────────────────────
# Provision at: Google Cloud Console → APIs & Services → Credentials
# TO-DO: human must create OAuth 2.0 Client ID per PRD §26.2
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# ── Apple Sign In ──────────────────────────────────────────
# Provision at: Apple Developer Portal → Certificates, IDs & Profiles
# TO-DO: human must provision Apple Sign-In credentials per PRD §26.2
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID
APPLE_PRIVATE_KEY_PATH=/path/to/apple/AuthKey_XXXXXXXXXX.p8

# ── Stripe ─────────────────────────────────────────────────
# Provision at: Stripe Dashboard → Developers → API Keys
# TO-DO: human must provision Stripe keys per PRD §26.2
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── S3-compatible Object Storage ───────────────────────────
# Compatible with AWS S3, DigitalOcean Spaces, MinIO, etc.
# TO-DO: human must provision object storage per PRD §26.2
OBJECT_STORAGE_ENDPOINT=https://s3.amazonaws.com
OBJECT_STORAGE_BUCKET=teamhub-uploads
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=REPLACE_ME
OBJECT_STORAGE_SECRET_ACCESS_KEY=REPLACE_ME

# ── Sentry (error monitoring) ──────────────────────────────
# Provision at: sentry.io → New Project → Java / Spring Boot
# TO-DO: human must provision Sentry projects per PRD §26.2
SENTRY_DSN=https://REPLACE_ME@oXXXXXX.ingest.sentry.io/REPLACE_ME

# ── Google Maps Platform ───────────────────────────────────
# Provision at: Google Cloud Console → APIs & Services → Credentials → API Key
# Restrict the key to the Maps JavaScript API and Geocoding API.
# TO-DO: human must provision Google Maps API key per PRD §26.2
GOOGLE_MAPS_API_KEY=REPLACE_ME
