# ─────────────────────────────────────────────────────────────
# Teamhub Mobile — Environment Variables (Expo)
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# Only EXPO_PUBLIC_* variables are bundled into the app binary.
# See PRD §26.2 for the full provisioning checklist.
# ─────────────────────────────────────────────────────────────

# ── API ────────────────────────────────────────────────────
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# ── Sentry (error monitoring) ──────────────────────────────
# Provision at: sentry.io → New Project → React Native
# TO-DO: human must provision Sentry projects per PRD §26.2
EXPO_PUBLIC_SENTRY_DSN=https://REPLACE_ME@oXXXXXX.ingest.sentry.io/REPLACE_ME

# ── Google Maps Platform ───────────────────────────────────
# Provision at: Google Cloud Console → APIs & Services → Credentials → API Key
# Restrict the key to the Maps SDK for Android and Maps SDK for iOS.
# TO-DO: human must provision Google Maps API key per PRD §26.2
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=REPLACE_ME
