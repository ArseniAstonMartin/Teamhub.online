{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_ENV": "preview"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "TO-DO: set Apple ID for App Store submission",
        "ascAppId": "TO-DO: set App Store Connect App ID",
        "appleTeamId": "TO-DO: set Apple Team ID"
      },
      "android": {
        "serviceAccountKeyPath": "TO-DO: path to Google Play service account JSON key"
      }
    }
  }
}
