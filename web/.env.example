# ─────────────────────────────────────────────────────────────
# Teamhub Web SPA — Environment Variables (Vite)
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# Only VITE_* variables are embedded in the client bundle.
# See PRD §26.2 for the full provisioning checklist.
# ─────────────────────────────────────────────────────────────

# ── API ────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080

# ── Sentry (error monitoring) ──────────────────────────────
# Provision at: sentry.io → New Project → React
# TO-DO: human must provision Sentry projects per PRD §26.2
VITE_SENTRY_DSN=https://REPLACE_ME@oXXXXXX.ingest.sentry.io/REPLACE_ME

# ── Google Maps Platform ───────────────────────────────────
# Provision at: Google Cloud Console → APIs & Services → Credentials → API Key
# Restrict the key to the Maps JavaScript API.
# TO-DO: human must provision Google Maps API key per PRD §26.2
VITE_GOOGLE_MAPS_API_KEY=REPLACE_ME
